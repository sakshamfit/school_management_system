{
  "entities": {
    "SchoolInfo": {
      "title": "School Info",
      "description": "General school details and configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "affiliationNumber": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "logoUrl": { "type": "string" },
        "currentAcademicYear": { "type": "string" },
        "setupCompleted": { "type": "boolean" },
        "principalName": { "type": "string" },
        "currencySymbol": { "type": "string" }
      },
      "required": ["name", "email", "currentAcademicYear"]
    },
    "User": {
      "title": "User",
      "description": "Principal or Teacher profile and access credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["principal", "teacher"] },
        "password": { "type": "string" },
        "teacherCode": { "type": "string" },
        "assignedClassId": { "type": "string" },
        "assignedClassName": { "type": "string" },
        "subject": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "role", "status"]
    },
    "ClassRoom": {
      "title": "Class Room",
      "description": "Class grade and section",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "section": { "type": "string" },
        "classTeacherId": { "type": "string" },
        "classTeacherName": { "type": "string" },
        "roomNumber": { "type": "string" },
        "capacity": { "type": "number" },
        "totalStudents": { "type": "number" }
      },
      "required": ["name", "section"]
    },
    "Student": {
      "title": "Student",
      "description": "Enrolled student biodata and admission details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rollNumber": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "admissionNumber": { "type": "string" },
        "admissionDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "academicYear": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "rollNumber", "classId", "parentName", "status"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Daily student attendance log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "classId": { "type": "string" },
        "studentId": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent", "leave", "late"] },
        "timestamp": { "type": "string" }
      },
      "required": ["date", "classId", "studentId", "status"]
    },
    "TeacherAttendanceRecord": {
      "title": "Teacher Attendance Record",
      "description": "Daily teacher attendance log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "teacherCode": { "type": "string" },
        "status": { "type": "string" },
        "markedAt": { "type": "string" }
      },
      "required": ["date", "teacherId", "status"]
    },
    "FeeAccount": {
      "title": "Fee Account",
      "description": "Student fee summary ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "totalFee": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["studentId", "totalFee"]
    },
    "FeeTransaction": {
      "title": "Fee Transaction",
      "description": "Payment transaction and receipt",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "feeAccountId": { "type": "string" },
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["studentId", "amount", "paymentDate", "receiptNumber"]
    },
    "StudentResult": {
      "title": "Student Result",
      "description": "Exam marksheet and report card details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "examName": { "type": "string" },
        "totalMarks": { "type": "number" },
        "totalMaxMarks": { "type": "number" },
        "percentage": { "type": "number" },
        "grade": { "type": "string" },
        "subjects": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["studentId", "examName", "totalMarks", "percentage", "grade"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Exam schedule configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "academicYear": { "type": "string" }
      },
      "required": ["name", "academicYear"]
    },
    "PerformanceRecord": {
      "title": "Performance Record",
      "description": "Student behavior and remarks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "rating": { "type": "string" }
      },
      "required": ["studentId", "rating"]
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "Audit trail log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "timestamp"]
    }
  },
  "firestore": {
    "collections": {
      "school_data": {
        "description": "Root configuration and singleton docs for the school",
        "documents": {
          "main": {
            "entity": "SchoolInfo"
          }
        }
      },
      "users": {
        "description": "Teachers and staff accounts",
        "entity": "User"
      },
      "classes": {
        "description": "Classrooms and sections",
        "entity": "ClassRoom"
      },
      "students": {
        "description": "All student records",
        "entity": "Student"
      },
      "attendance": {
        "description": "Daily student attendance records",
        "entity": "AttendanceRecord"
      },
      "teacher_attendance": {
        "description": "Daily teacher attendance records",
        "entity": "TeacherAttendanceRecord"
      },
      "fee_accounts": {
        "description": "Student fee accounts",
        "entity": "FeeAccount"
      },
      "fee_transactions": {
        "description": "Fee payment receipts and logs",
        "entity": "FeeTransaction"
      },
      "exams": {
        "description": "Exam schedules",
        "entity": "Exam"
      },
      "results": {
        "description": "Student exam results and marksheets",
        "entity": "StudentResult"
      },
      "performance": {
        "description": "Student performance remarks",
        "entity": "PerformanceRecord"
      },
      "activity_logs": {
        "description": "System activity logs",
        "entity": "ActivityLog"
      }
    }
  }
}
