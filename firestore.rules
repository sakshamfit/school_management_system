rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// HARDENED RULES (2026-09-02)
//
// Previously: `allow read, write: if true;` — the entire school database was
// world-readable and world-writable to anyone on the internet. That is closed.
//
// Now: every request must carry a Firebase Authentication session
//   - Principal  → Firebase Auth email/password account (created in the
//                  Firebase console; see DEPLOYMENT.md §Authentication)
//   - Teachers   → anonymous Firebase session established by the app before
//                  their 6-digit code is validated
//
// KNOWN LIMITATION (documented in PRODUCTION_REPORT.md): any *authenticated*
// session can still read/write every document. Per-user least-privilege rules
// (role claims, per-school isolation) ship with the phase-2 local-SQLite
// architecture, where school data leaves Firestore entirely.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
